# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Service Metadata
SERVICE_NAME=cloudops-api
SERVICE_VERSION=1.0.0

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudops_db

# Local connection URL (outside docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudops_db